<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production domain with HTTPS only -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">
            work-time-tracker-api-cpdeb7e7b9axazd0.swedencentral-01.azurewebsites.net
        </domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Debug/Development - allow cleartext for local testing -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.0.52</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>

